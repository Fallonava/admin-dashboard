# Environment variables example for MedCore Admin
# Copy this file to .env and fill in the actual values

# Prisma Database Connection
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?sslmode=disable"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB]?sslmode=disable"

# Database connection details
PGHOST="[HOST]"
PGUSER="[USER]"
PGDATABASE="[DB]"
PGPASSWORD="[PASSWORD]"

# Authentication & Security (Server-side ONLY - NEVER expose with NEXT_PUBLIC_)
ADMIN_KEY="your_admin_key_min_8_chars"
CRON_SECRET="your_cron_secret_here"
JWT_SECRET="your_secure_jwt_secret_min_32_chars_long_string"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Sentry Error Tracking (Optional) ──
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
